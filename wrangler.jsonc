{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cssdaily",
  "compatibility_date": "2026-11-10",
  // Assets-only Worker: no "main" script. Requests are served straight
  // from dist/ and never invoke Worker code (static requests are free).
  "assets": {
    "directory": "./dist",
    // Serves the nearest 404.html AT THE REQUESTED URL with status 404,
    // the same contract GitHub Pages had. ChallengeRedirect.astro reads
    // location.pathname on the 404 page to clamp and redirect dates.
    "not_found_handling": "404-page",
    // /challenge/<date> → /challenge/<date>/ (the build emits
    // <route>/index.html)
    "html_handling": "auto-trailing-slash"
  },
  // Production: a route on the proxied cssdaily.dev zone, not a custom
  // domain. While GitHub Pages is still published, deleting this route
  // falls straight back to GitHub; see the 1b plan for the rollback.
  // www needs no route: a zone Redirect Rule 301s it to the apex at the
  // edge, before routes apply.
  "routes": [
    { "pattern": "cssdaily.dev/*", "zone_name": "cssdaily.dev" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  // Challenge data (Phase 2). Not read by the Worker yet: the site is
  // prerendered from a build-time pull. Listed so `wrangler d1` commands
  // (migrations, export) resolve the database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cssdaily",
      "database_id": "52a5542b-2852-4250-890a-d4e1dc691005",
      "migrations_dir": "migrations"
    }
  ]
}
