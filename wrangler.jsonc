{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cssdaily",
  "compatibility_date": "2026-11-10",
  // The site is a static Astro build; this small script (bundled by
  // wrangler) only receives requests no static asset matched — asset-first
  // routing, run_worker_first unset — plus the cron triggers.
  "main": "./src/worker.ts",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serves the nearest 404.html AT THE REQUESTED URL with status 404,
    // the same contract GitHub Pages had. ChallengeRedirect.astro reads
    // location.pathname on the 404 page to clamp and redirect dates.
    // src/worker.ts hands unmatched paths back here to keep that.
    "not_found_handling": "404-page",
    // /challenge/<date> → /challenge/<date>/ (the build emits
    // <route>/index.html)
    "html_handling": "auto-trailing-slash"
  },
  // Production: a route on the proxied cssdaily.dev zone, not a custom
  // domain. www needs no route: a zone Redirect Rule 301s it to the apex at
  // the edge, before routes apply.
  "routes": [
    { "pattern": "cssdaily.dev/*", "zone_name": "cssdaily.dev" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs: per-invocation CPU time and cron failures
  "observability": { "enabled": true },
  "vars": {
    "SITE_URL": "https://cssdaily.dev"
  },
  // Cloudflare crons dispatch the GitHub workflows (src/lib/dispatch.ts):
  // daily generation, weekly backup. UTC. Day-of-week as a name (SUN):
  // Cloudflare numbers days 1–7 from Sunday and rejects 0.
  "triggers": {
    "crons": ["0 6 * * *", "0 3 * * SUN"]
  },
  // Approximate, per-location limiter for POST /api/plays
  "ratelimits": [
    {
      "name": "PLAYS_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  // Challenge data (Phase 2) and anonymous plays (Phase 3). The site is
  // still built from a build-time pull; the Worker uses DB for /api/*.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cssdaily",
      "database_id": "52a5542b-2852-4250-890a-d4e1dc691005",
      "migrations_dir": "migrations"
    }
  ]
}
