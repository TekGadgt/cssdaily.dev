AI_PROVIDER=openai
AI_MODEL=gpt-5.6-terra
OPENAI_API_KEY=your_openai_api_key_here
# Required only when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Cloudflare (challenge data in D1, target images in R2) ---
# None of these are needed to run the site locally: without a D1 token,
# `npm run data:pull` downloads the public snapshot. Blank values count as unset.
# Account ID: the hex string in any Cloudflare dashboard URL
CLOUDFLARE_ACCOUNT_ID=
# `npx wrangler d1 list`
D1_DATABASE_ID=
# D1 Read: lets data:pull read the database directly
D1_READ_TOKEN=
# D1 Edit: needed by the import and the generator (also accepted for reads)
D1_WRITE_TOKEN=
# R2 key scoped to the cssdaily-assets bucket (Object Read & Write)
R2_ASSETS_ACCESS_KEY_ID=
R2_ASSETS_SECRET_ACCESS_KEY=
# Where target images and the public snapshot are served from
PUBLIC_ASSET_BASE=
